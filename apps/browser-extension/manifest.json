{
  "manifest_version": 3,
  "name": "IP Guard · Claude 防护",
  "version": "0.8.0",
  "description": "按 IP Guard 锁定的 Claude AI 出口 IPv4 保护 Claude 网页。",
  "minimum_chrome_version": "120",
  "icons": { "32": "icon.png" },
  "key": "",
  "permissions": ["nativeMessaging", "declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["*://claude.ai/*", "*://*.claude.ai/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IP Guard",
    "default_icon": "icon.png"
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "guard", "enabled": true, "path": "rules.json" }]
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "chunks/*", "assets/*"],
      "matches": ["*://claude.ai/*", "*://*.claude.ai/*"]
    }
  ]
}
